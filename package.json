{
  "name": "cognitive-os",
  "version": "3.0.0",
  "description": "Universal multi-harness cognitive operating system specification for AI coding agents",
  "private": true,
  "scripts": {
    "dev": "npm run validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "markdownlint-cli2",
    "lint:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "context.dev": "^2.8.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
